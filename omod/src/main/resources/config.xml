<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>${project.parent.groupId}.${project.parent.artifactId}</package>
	<author>OpenMRS</author>
	<description>
		${project.parent.description}
	</description>
	<updateURL>https://modules.openmrs.org/modules/download/${project.parent.artifactId}/update.rdf</updateURL>
	<require_version>${openMRSVersion}</require_version>
	<!-- / Module Properties -->

	
	<!-- Required Modules -->
	<!--
		uiframework/appui are intentionally NOT required here: this build only uses this
		module's AOP interceptors (location-based data restriction) and its own legacyui
		integration (see the <extension> below), not its original OWA/uiframework "Manage
		Account" fragments, which are unused in an O3-based distro and would otherwise force
		installing two more legacy modules just to satisfy an unused UI path.
	-->
	<require_modules>
		<require_module version="2.2.0">org.openmrs.module.webservices.rest</require_module>
	</require_modules>
	<!-- / Required Modules -->

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>

	<extension>
		<point>org.openmrs.userForm.custom.extension</point>
		<class>org.openmrs.module.locationbasedaccess.extension.html.UserFormLocationExtension</class>
	</extension>
	
	<!-- Module Activator -->
	<activator>${project.parent.groupId}.${project.parent.artifactId}.LocationBasedAccessActivator</activator>
	
	
	<privilege>
		<name>End Visits At Any Location</name>
		<description>Able to end a visit that was started at a location other than the current session location</description>
	</privilege>

	<globalProperty>
		<property>locationbasedaccess.access.visitEnd</property>
		<defaultValue>true</defaultValue>
		<description>
			When true, a visit can only be ended from a session logged in at the visit's location (super users,
			daemon tasks and holders of "End Visits At Any Location" are exempt). Set to false to turn the rule off.
		</description>
	</globalProperty>

	<!-- Maps hibernate file's, if present -->
	<mappingFiles>
				
	</mappingFiles>

	<!-- Internationalization -->
	<!-- All message codes should start with ${project.parent.artifactId}. -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->

	<advice>
		<point>org.openmrs.api.PatientService</point>
		<class>org.openmrs.module.locationbasedaccess.aop.PatientSearchAdviser</class>
	</advice>
	<advice>
		<point>org.openmrs.api.PersonService</point>
		<class>org.openmrs.module.locationbasedaccess.aop.PersonSearchAdviser</class>
	</advice>
	<advice>
		<point>org.openmrs.api.EncounterService</point>
		<class>org.openmrs.module.locationbasedaccess.aop.EncounterSearchAdviser</class>
	</advice>
	<advice>
		<point>org.openmrs.api.UserService</point>
		<class>org.openmrs.module.locationbasedaccess.aop.UserSearchAdviser</class>
	</advice>
	<advice>
		<point>org.openmrs.api.LocationService</point>
		<class>org.openmrs.module.locationbasedaccess.aop.LocationSearchAdviser</class>
	</advice>
</module>

